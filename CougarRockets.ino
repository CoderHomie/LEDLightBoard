void setup() {
  delay(TEN_SECONDS); // power-up safety delay
  FastLED.addLeds<LED_TYPE, DATA_PIN, COLOR_ORDER>(leds, NUM_LEDS);
  FastLED.setMaxPowerInVoltsAndMilliamps(VOLTS, MAX_AMPS); //Takes precedence over brightness
  FastLED.setBrightness(BRIGHTNESS);
  FastLED.clear();
  FastLED.show();
}

void loop() {
  DisplayCougarRockets();
  DisplayRocket();
}

void ShowAndReset(int r)
{
  FastLED.show();
  delay(r);
  FastLED.clear();
}

void DisplayCougarRockets() {
  // Red
  for (i = 0; i < 355; ++i) {
    curr = pgm_read_word(&(cougarRocketsRed[i]));
    leds[curr] = CRGB(228,8,10);
  }

  // Grass
  for (i = 0; i < 84; ++i) {
    curr = pgm_read_word(&(cougarRocketsGrass[i]));
    leds[curr] = CRGB(7,160,18);
  }

  // Flame
  for (i = 0; i < 15; ++i) {
    curr = pgm_read_word(&(cougarRocketsFlame[i]));
    leds[curr] = CRGB(255,40,3);
  }

  // Smoke
  for (i = 0; i < 9; ++i) {
    curr = pgm_read_word(&(cougarRocketsSmoke[i]));
    leds[curr] = CRGB(16,16,16);
  }

  ShowAndReset(TEN_SECONDS);
}

void DisplayRocket() {
  j = 0;
  while (j < 10) {
    //Red
    for (i = 0; i < 500; ++i) {
      curr = pgm_read_word(&rocketRed[i]);
      leds[curr] = CRGB(228,8,10);
    }

    //LgtGry
    for (i = 0; i < 45; ++i) {
      curr = pgm_read_word(&rocketLgtGry[i]);
      leds[curr] = CRGB(48,48,48);
    }
    
    //DrkGry
    for (i = 0; i < 16; ++i) {
      curr = pgm_read_word(&rocketDrkGry[i]);
      leds[curr] = CRGB(16,16,16);
    }

    //Flames
    for (i = 1; i < pgm_read_word(&(rocketFlames[j%3][0])); ++i) {
      curr = pgm_read_word(&(rocketFlames[j%3][i]));
      leds[curr] = CRGB(255,40,3);
    }
    ++j;

    ShowAndReset(ONE_SECOND);
  }
}